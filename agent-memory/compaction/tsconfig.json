  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
