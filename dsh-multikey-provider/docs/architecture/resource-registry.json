{
  "status": "design",
  "resources": [
    {
      "resource_id": "composition.official-provider-entry",
      "kind": "control",
      "owner": "installed DSH profile",
      "truth_store": "effective profile entry list",
      "allowed_operations": ["observe-active"],
      "forbidden_operations": ["disable", "replace", "rename", "delete"]
    },
    {
      "resource_id": "composition.official-models-entry",
      "kind": "control",
      "owner": "exact-name client disable patch",
      "truth_store": "effective profile entry list",
      "allowed_operations": ["disable-client-entry", "restore-after-bundle-removal-and-restart"],
      "forbidden_relations": ["business.request", "secret.credential-value"]
    },
    {
      "resource_id": "composition.multikey-entry",
      "kind": "control",
      "owner": "bundle insert patch",
      "truth_store": "effective profile entry list",
      "allowed_operations": ["insert", "mount-host-and-client", "remove-with-bundle"],
      "forbidden_relations": ["composition.official-provider-entry"]
    },
    {
      "resource_id": "registry.official-routes",
      "kind": "control",
      "owner": "@deepseek-ai/dsh-llm-pi-ai",
      "truth_store": "DSH adapter registry",
      "allowed_operations": ["observe"],
      "forbidden_operations": ["register-by-plugin", "replace-by-plugin", "unregister-by-plugin"]
    },
    {
      "resource_id": "registry.pool-routes",
      "kind": "control",
      "owner": "MultiKeyProviderAdapter registration",
      "truth_store": "DSH adapter registry",
      "allowed_operations": ["register-new-route", "atomic-replace-own-routes", "remove-own-routes"],
      "forbidden_operations": ["collide", "take-over-official-route"]
    },
    {
      "resource_id": "settings_namespace:llm-pi-ai",
      "kind": "truth",
      "owner": "@deepseek-ai/dsh-llm-pi-ai",
      "truth_store": "settings provider",
      "allowed_operations": ["observe-through-public-wire"],
      "forbidden_operations": ["register-by-plugin", "write-pool-config"]
    },
    {
      "resource_id": "settings_namespace:multikey-provider",
      "kind": "truth",
      "owner": "dsh-multikey-provider",
      "truth_store": "settings provider",
      "allowed_operations": ["register", "validate", "mutate-pool-profiles"],
      "forbidden_relations": ["secret.credential-value", "business.request", "business.response"]
    },
    {
      "resource_id": "settings_section:models",
      "kind": "projection",
      "owner": "active Models client entry",
      "truth_store": "client slot registry",
      "allowed_operations": ["register-one-owner", "project-public-wire-state"],
      "forbidden_relations": ["secret.credential-value", "business.request", "business.response"]
    },
    {
      "resource_id": "config.pool-profile",
      "kind": "truth",
      "owner": "compilePoolProfiles",
      "truth_store": "multikey-provider settings namespace",
      "allowed_operations": ["validate-candidate", "compile-immutable-snapshot"],
      "forbidden_relations": ["secret.credential-value"]
    },
    {
      "resource_id": "backend.official-adapter",
      "kind": "runtime",
      "owner": "captureOfficialBackend",
      "truth_store": "process-local immutable pool snapshot",
      "allowed_operations": ["public-entrypoint-capture", "catalog-backend", "custom-backend", "stream"],
      "forbidden_operations": ["register-real-backend-route", "register-llm-pi-ai-namespace", "register-official-directory"]
    },
    {
      "resource_id": "business.request",
      "kind": "truth",
      "owner": "caller and MultiKeyProviderAdapter",
      "truth_store": "caller",
      "allowed_operations": ["read", "map-pool-route-to-backend-route", "forward"],
      "forbidden_relations": ["control.key-pool", "control.probe", "secret.credential-value"]
    },
    {
      "resource_id": "business.response",
      "kind": "truth",
      "owner": "captured official backend and MultiKeyProviderAdapter",
      "truth_store": "stream consumer",
      "allowed_operations": ["buffer-prebusiness", "forward", "terminalize"],
      "forbidden_relations": ["control.key-pool", "secret.credential-value"]
    },
    {
      "resource_id": "control.key-pool",
      "kind": "control",
      "owner": "KeyPoolRuntime",
      "truth_store": "process-local state",
      "allowed_operations": ["select", "reserve-trial", "record-success", "record-key-failure", "project-redacted"],
      "forbidden_relations": ["business.request", "business.response", "session.event"]
    },
    {
      "resource_id": "secret.credential-reference",
      "kind": "secret-reference",
      "owner": "compiled pool profile",
      "truth_store": "multikey-provider settings namespace",
      "allowed_operations": ["identify-key", "copy-reference", "resolve"]
    },
    {
      "resource_id": "secret.credential-value",
      "kind": "secret",
      "owner": "credentials service and one attempt",
      "truth_store": "credentials service or launch environment",
      "allowed_operations": ["write", "resolve-one-attempt", "explicit-reveal"],
      "forbidden_relations": ["settings", "ordinary-rpc", "log", "session.event", "business.request", "business.response", "health.projection"]
    },
    {
      "resource_id": "control.probe",
      "kind": "control",
      "owner": "MultiKeyControl.probe",
      "truth_store": "none",
      "allowed_operations": ["exact-key-bounded-call", "record-health", "return-redacted"],
      "forbidden_relations": ["business.request", "session.event", "secret.credential-value"]
    },
    {
      "resource_id": "projection.key-health",
      "kind": "projection",
      "owner": "MultiKeyControl.view",
      "truth_store": "none",
      "allowed_operations": ["read-redacted"],
      "forbidden_relations": ["secret.credential-value"]
    },
    {
      "resource_id": "secret.reveal",
      "kind": "secret-control",
      "owner": "MultiKeySecretControl.reveal",
      "truth_store": "none",
      "allowed_operations": ["loopback", "exact-configured-reference", "explicit-user-gesture", "transient-client-state"],
      "forbidden_relations": ["settings", "ordinary-rpc", "log", "session.event", "business.request", "business.response", "shared-client-store", "error.message"]
    }
  ],
  "relations": [
    {"from": "composition.multikey-entry", "via": "host mount", "to": "settings_namespace:multikey-provider"},
    {"from": "composition.multikey-entry", "via": "host mount", "to": "registry.pool-routes"},
    {"from": "composition.official-models-entry", "via": "exact-name disable", "to": "settings_section:models"},
    {"from": "settings_namespace:multikey-provider", "via": "compilePoolProfiles", "to": "config.pool-profile"},
    {"from": "config.pool-profile", "via": "captureOfficialBackend", "to": "backend.official-adapter"},
    {"from": "business.request", "via": "MultiKeyProviderAdapter.stream", "to": "backend.official-adapter"},
    {"from": "backend.official-adapter", "via": "captured stream", "to": "business.response"},
    {"from": "control.key-pool", "via": "selected descriptor", "to": "secret.credential-reference"},
    {"from": "secret.credential-reference", "via": "resolveCredential", "to": "secret.credential-value"},
    {"from": "control.probe", "via": "probeKey", "to": "control.key-pool"},
    {"from": "control.key-pool", "via": "view", "to": "projection.key-health"},
    {"from": "secret.credential-value", "via": "explicit reveal", "to": "secret.reveal"},
    {"from": "settings_section:models", "via": "public admin wires", "to": "settings_namespace:multikey-provider"}
  ]
}
