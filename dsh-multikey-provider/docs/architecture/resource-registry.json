  "relations": [
    {
      "from": "composition.official-provider-entry",
      "via": "exact-name disable patch",
      "to": "composition.replacement-provider-entry"
    },
    {
      "from": "composition.official-models-entry",
      "via": "exact-name disable patch",
      "to": "composition.replacement-models-client"
    },
    {
      "from": "composition.replacement-provider-entry",
      "via": "replacement host owner from audited rc.6 source baseline",
      "to": "config.provider-profile"
    },
    {
      "from": "composition.replacement-models-client",
      "via": "settings and control RPC",
      "to": "config.provider-profile"
    },
    {
      "from": "composition.replacement-models-client",
      "via": "credentials.set write-only call",
      "to": "secret.credential-reference"
    },
    {
      "from": "config.provider-profile",
      "via": "resolveProfiles",
      "to": "control.key-pool-runtime"
    },
    {
      "from": "business.llm-request",
      "via": "ReplacementPiAiAdapter.stream",
      "to": "business.llm-response"
    },
    {
      "from": "control.key-pool-runtime",
      "via": "ReplacementPiAiAdapter.stream",
      "to": "secret.credential-reference"
    },
    {
      "from": "secret.credential-reference",
      "via": "resolveCredential",
      "to": "control.credential-resolution"
    },
    {
      "from": "control.credential-resolution",
      "via": "credential service or launch environment",
      "to": "secret.credential-value"
    },
    {
      "from": "secret.credential-value",
      "via": "one outbound attempt",
      "to": "pi-ai provider"
    },
    {
      "from": "secret.credential-value",
      "via": "MultiKeySecretControl.reveal",
      "to": "secret.credential-reveal"
    },
    {
      "from": "secret.credential-reveal",
      "via": "explicit reveal or copy gesture",
      "to": "composition.replacement-models-client"
    },
    {
      "from": "control.probe",
      "via": "ReplacementPiAiAdapter.probeKey",
      "to": "control.key-pool-runtime"
    },
    {
      "from": "control.key-pool-runtime",
      "via": "MultiKeyControl.view",
      "to": "projection.key-health-view"
    }
  ]
}
