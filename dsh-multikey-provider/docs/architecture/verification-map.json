{
  "status": "design",
  "features": {
    "replacement.composition": [
      "profile compose fixture checks exact target names",
      "installed dump-config shows official provider and Models disabled",
      "installed dump-config shows replacement provider active",
      "route namespace and Models section unique-owner gates",
      "bundle removal plus restart restores official entries"
    ],
    "replacement.official-baseline": [
      "official parity fixtures",
      "catalog custom and discovery tests",
      "single-key dynamic settings and HMR"
    ],
    "replacement.key-pool": [
      "compiler positive and negative tests",
      "priority and weighted tests",
      "health state tests",
      "payload isolation gate"
    ],
    "replacement.credentials": [
      "credential resolution tests",
      "named missing credential test",
      "attempt-local credential lifetime test",
      "secret redaction test"
    ],
    "replacement.adapter": [
      "stream paired tests",
      "abort and no-late-switch tests",
      "catalog and custom live smoke",
      "OpenCode Go deepseek-v4-flash live smoke"
    ],
    "replacement.control": [
      "control transaction tests",
      "loopback and redaction tests"
    ],
    "replacement.secret-control": [
      "loopback-only exact-reference reveal test",
      "explicit user gesture reveal and copy test",
      "timeout blur route-change and unmount clearing tests",
      "ordinary RPC settings business payload store log and error isolation tests"
    ],
    "replacement.models-client": [
      "official Models client parity tests",
      "alternate add rotate status copy-ref enable probe tests",
      "credential write-only and secret-redaction tests",
      "single Models section owner and replacement-only boot graph",
      "client build and browser smoke"
    ],
    "replacement.restore": [
      "remove replacement bundle",
      "exact service or PID restart",
      "restored dump-config official active replacement absent",
      "restored route namespace and Models owner uniqueness",
      "original provider model and Models settings replay"
    ]
  },
  "build_entrypoints": {
    "design": "node docs/architecture/verify-design.mjs",
    "design_ci": ".github/workflows/dsh-multikey-provider-design.yml",
    "prebuild": "pnpm run verify:architecture",
    "ci": "pnpm run check"
  },
  "active_gate_contract": {
    "package_name": "dsh-llm-pi-ai-multikey",
    "registry_status": "active",
    "source_coverage": "every src TypeScript file has exactly one module owner",
    "import_graph": "every cross-module source import is declared",
    "control_owner_path": "src/control.ts",
    "secret_control_owner_path": "src/secret-control.ts",
    "forbidden_legacy_paths": [
      "src/admin.ts",
      "src/client/MultiKeySettings.tsx",
      "src/compiler.ts",
      "src/health.ts",
      "src/probe.ts",
      "src/rpc.ts",
      "src/scheduler.ts"
    ],
    "forbidden_legacy_semantics": [
      "multikey/ provider route prefix",
      "multikey-provider settings namespace",
      "/multikey/api ordinary HTTP control endpoint"
    ]
  },
  "required_delivery_gates": [
    "registry-gate",
    "exact-target-name-test",
    "typecheck",
    "lint",
    "tests",
    "coverage",
    "build",
    "pack",
    "loader-smoke",
    "hmr-smoke",
    "wire-smoke",
    "secret-scan",
    "browser-smoke",
    "installed-profile-dump",
    "installed-route-owner-uniqueness",
    "installed-namespace-owner-uniqueness",
    "installed-models-owner-uniqueness",
    "installed-client-boot-graph",
    "restart",
    "live-catalog-smoke",
    "live-custom-smoke",
    "live-opencode-go-smoke",
    "remove-bundle",
    "restore-restart",
    "restored-profile-dump",
    "restored-official-provider-smoke",
    "restored-official-models-smoke",
    "dsh-review"
  ]
}
