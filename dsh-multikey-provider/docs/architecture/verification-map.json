  "design_gate": {
    "command": "node docs/architecture/verify-design.mjs",
    "ci": ".github/workflows/dsh-multikey-provider-design.yml",
    "requirements": [
      "all architecture registries remain status design before approval",
      "official insertion seams are explicitly proven unavailable",
      "official source scaffold and rc.6 runtime authorities are pinned",
      "Cordis patch is exact disable plus independent insert",
      "Models exposure and layout rules are machine asserted",
      "control and business resources remain physically distinct",
      "transition-delete registry cleanup and active-gate pending revision are surfaced",
      "UI mockup states exist as interactive HTML and frozen PNG for desktop, mobile, and dark viewports",
      "Mockup artifacts are linked from canonical docs and required by the design gate",
      "Mockup additions stay inside the existing ProviderEditor for a configured llm-pi-ai row",
      "Every mockup artifact path in composition-manifest.models_ui.mockup_artifacts must exist",
      "Mockup viewport claims match PNG headers for desktop, mobile, and dark artifacts",
      "Every mockup state id and section heading listed in composition-manifest.models_ui.mockup_states binds to one scenario section in docs/ui/multikey-ui-states.html",
      "The standalone artifact is regenerated from the interactive HTML source",
      "The UI render command is present and its script passes Node syntax validation"
    ]
  },
  "active_gate_contract": {
    "status": "pending-revision-after-design-approval",
    "package_name": "dsh-llm-pi-ai-multikey",
    "forbidden_legacy_paths": [
      "src/wire.ts",
      "src/secret-control.ts",
      "tests/wire.test.ts",
      "tests/secret-control.test.ts"
    ],
    "control_owner_path": "src/control.ts",
    "secret_control_owner_path": null,
    "required_revision": "rewrite scripts/verify-architecture.mjs after design approval to the official-derived module graph; remove secret-control and transition-delete owners, allowed edges, call-map endpoints, resource relations, and verification gate targets; bind the replacement client composition mount; do not run the current script against active registries"
  },
  "implementation_gate": {
    "command": "pnpm run check",
    "required_after_approval": [
      "architecture",
      "typecheck",
      "lint",
      "paired tests",
      "coverage",
      "build",
      "pack inspection"
    ]
  },
  "live_gate": {
    "install": [
      "install bundle",
      "restart DSH",
      "dump-config",
      "unique owners",
      "browser layout/exposure smoke",
      "real provider positive and negative calls"
    ],
    "restore": [
      "remove bundle",
      "restart DSH",
      "dump-config",
      "official-only owners",
      "original provider and Models replay"
    ]
  },
  "review_gate": {
    "design": "DSH Review PASS before source implementation",
    "delivery": "DSH Review PASS after installed live verification"
  }
}
