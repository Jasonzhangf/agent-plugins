      "resource_ids": [
        "config.provider-profile",
        "secret.credential-reference"
      ],
      "positive": [
        "official profile without a pool preserves single-key behavior",
        "valid alternate references compile"
      ],
      "negative": [
        "duplicate or invalid references fail at the settings boundary"
      ],
      "attachment": "package.json#scripts.check"
    },
    {
