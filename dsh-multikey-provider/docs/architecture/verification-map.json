        "composition.official-models-entry",
        "composition.replacement-entry",
        "provider_routes",
        "settings_namespace:llm-pi-ai",
        "settings_section:models"
      ],
      "positive": [
        "exact-name disable plus independent insert",
        "one installed and restored owner per exclusive resource"
      ],
      "negative": [
        "wrong target name",
        "duplicate route, namespace, or Models owner"
      ],
      "attachment": ".github/workflows/dsh-multikey-provider-design.yml"
    },
    {
      "gate_id": "implementation.provider-parity",
