{
  "schema_version": 1,
  "resources": [
    {
      "resource_id": "appsdk_project_contract",
      "owner": "appsdk::project_contract",
      "kind": "governance_truth",
      "truth_store": ".appsdk/project.json",
      "allowed_operations": ["read", "validate", "write_during_design"]
    },
    {
      "resource_id": "governance_build_surface",
      "owner": "dsh-tui::governance-build",
      "kind": "governance_projection",
      "truth_store": "package_manifest_maps_verifiers_and_ci",
      "allowed_operations": ["validate_owner_coverage", "validate_gate_wiring", "compile_deterministic_build_contract"]
    },
    {
      "resource_id": "official_dsh_host",
      "owner": "deepseek-ai::dsh-web-host",
      "kind": "external_truth",
      "truth_store": "configured_loopback_endpoint",
      "allowed_operations": ["connect", "health_check"]
    },
    {
      "resource_id": "official_session_log",
      "owner": "deepseek-ai::dsh-session",
      "kind": "business_truth",
      "truth_store": "official_dsh_host/session_log",
      "allowed_operations": ["read_via_public_api", "append_via_public_owner"]
    },
    {
      "resource_id": "official_api_contract",
      "owner": "deepseek-ai::dsh-host-apiproxy",
      "kind": "business_contract",
      "truth_store": "published_package_exports",
      "allowed_operations": ["import_public_symbols", "call", "subscribe", "respond"]
    },
    {
      "resource_id": "official_webui_reference",
      "owner": "deepseek-ai::dsh-webui",
      "kind": "reference_only",
      "truth_store": "pinned_source_commit_and_tests",
      "allowed_operations": ["read_for_behavior_audit"]
    },
    {
      "resource_id": "transport_control",
      "owner": "dsh-tui::transport",
      "kind": "control_side_channel",
      "truth_store": "validated_process_configuration_and_process_memory",
      "allowed_operations": ["resolve_endpoint_by_precedence", "validate_loopback_origin", "connect", "reconnect_same_endpoint", "abort", "report_health"]
    },
    {
      "resource_id": "current_session_selection",
      "owner": "dsh-tui::session",
      "kind": "client_state",
      "truth_store": "process_memory",
      "allowed_operations": ["create_current_cwd", "resume_current_cwd", "clear_on_exit"]
    },
    {
      "resource_id": "tui_presentation_model",
      "owner": "dsh-tui::presentation",
      "kind": "business_projection",
      "truth_store": "process_memory",
      "allowed_operations": ["hydrate", "project", "replace_from_history", "apply_public_event"]
    },
    {
      "resource_id": "terminal_component_registry",
      "owner": "dsh-tui::component-registry",
      "kind": "presentation_registry",
      "truth_store": "compiled_registry_manifest_and_cordis_context",
      "allowed_operations": ["register_typed_component", "resolve_typed_component", "dispose", "compile_manifest"]
    },
    {
      "resource_id": "tui_app_event_bus",
      "owner": "dsh-tui::app-event-bus",
      "kind": "typed_control_side_channel",
      "truth_store": "process_memory",
      "allowed_operations": ["publish_typed_intent", "subscribe", "dispose"]
    },
    {
      "resource_id": "tui_focus_overlay_stack",
      "owner": "dsh-tui::focus-manager",
      "kind": "interaction_control",
      "truth_store": "process_memory",
      "allowed_operations": ["push_view", "pop_view", "focus", "restore_focus"]
    },
    {
      "resource_id": "terminal_input_control",
      "owner": "dsh-tui::app-shell",
      "kind": "typed_control_side_channel",
      "truth_store": "process_memory",
      "allowed_operations": ["edit_composer", "publish_submit_intent", "scroll_transcript", "select_overlay_item"]
    },
    {
      "resource_id": "pending_input_projection",
      "owner": "dsh-tui::app-shell",
      "kind": "ephemeral_business_projection",
      "truth_store": "process_memory_until_official_event_convergence",
      "allowed_operations": ["project_submitted_input_as_pending", "mark_failed", "remove_after_matching_official_user_event"]
    },
    {
      "resource_id": "terminal_lifecycle",
      "owner": "dsh-tui::terminal-lifecycle",
      "kind": "terminal_control",
      "truth_store": "single_ink_render_instance",
      "allowed_operations": ["enter", "render", "suspend", "resume", "restore"]
    },
    {
      "resource_id": "terminal_failure_chain",
      "owner": "dsh-tui::terminal-lifecycle",
      "kind": "typed_error_chain",
      "truth_store": "process_memory_until_typed_startup_outcome",
      "allowed_operations": ["record_terminal_failure", "restore_terminal", "project_typed_failure_outcome"]
    },
    {
      "resource_id": "process_exit_control",
      "owner": "dsh-tui::app-shell",
      "kind": "typed_control_side_channel",
      "truth_store": "top_level_cli_or_plugin_exit_owner",
      "allowed_operations": ["report_terminal_failure", "map_normal_exit", "map_failure_exit"]
    },
    {
      "resource_id": "tui_fixture_corpus",
      "owner": "dsh-tui::fixture-contract",
      "kind": "test_truth",
      "truth_store": "versioned_fixture_bundle",
      "allowed_operations": ["validate", "consume_for_terminal_test", "consume_for_simulator"]
    },
    {
      "resource_id": "client_only_profile",
      "owner": "dsh-tui::installer",
      "kind": "installation_contract",
      "truth_store": "$DSH_HOME/profiles/tui",
      "allowed_operations": ["install", "verify", "uninstall"]
    },
    {
      "resource_id": "static_simulation",
      "owner": "dsh-tui::simulator",
      "kind": "review_projection",
      "truth_store": "generated_simulator_artifact",
      "allowed_operations": ["render_fixture", "capture_visual_evidence"]
    },
    {
      "resource_id": "tui_app_container_composition",
      "owner": "dsh-tui::app-container",
      "kind": "presentation_composition",
      "truth_store": "immutable_tui_app_view_model_and_layout_policy",
      "allowed_operations": ["compose_slots", "switch_layout_policy", "refresh_frame", "dispose"]
    },
    {
      "resource_id": "app_composition_failure_chain",
      "owner": "dsh-tui::app-container",
      "kind": "typed_error_chain",
      "truth_store": "immutable_typed_composition_result",
      "allowed_operations": ["record_app_composition_failure", "project_terminal_failure_input"]
    },
    {
      "resource_id": "tui_chrome_slot_registry",
      "owner": "dsh-tui::chrome-controls",
      "kind": "presentation_slot_projection",
      "truth_store": "immutable_typed_chrome_slot_models",
      "allowed_operations": ["register_plugin", "project_slots", "dispose"]
    },
    {
      "resource_id": "logic_control_registry",
      "owner": "dsh-tui::logic-controls",
      "kind": "typed_control_side_channel",
      "truth_store": "process_memory",
      "allowed_operations": ["register_source", "project_control", "subscribe_invalidation"]
    }
  ],
  "required_relations": [
    {"from": "governance_build_surface", "via": "validated_against", "to": "appsdk_project_contract"},
    {"from": "transport_control", "via": "validated_loopback_endpoint", "to": "official_dsh_host"},
    {"from": "official_webui_reference", "via": "behavior_audit", "to": "tui_presentation_model"},
    {"from": "official_api_contract", "via": "transport", "to": "current_session_selection"},
    {"from": "official_session_log", "via": "official_api_contract", "to": "tui_presentation_model"},
    {"from": "tui_presentation_model", "via": "typed_component_props", "to": "terminal_component_registry"},
    {"from": "terminal_component_registry", "via": "typed_component_tree", "to": "terminal_lifecycle"},
    {"from": "terminal_lifecycle", "via": "typed_terminal_failure", "to": "terminal_failure_chain"},
    {"from": "terminal_failure_chain", "via": "typed_startup_outcome", "to": "process_exit_control"},
    {"from": "tui_app_event_bus", "via": "typed_action_dispatch", "to": "official_api_contract"},
    {"from": "terminal_input_control", "via": "typed_terminal_intent", "to": "tui_app_event_bus"},
    {"from": "terminal_input_control", "via": "typed_shell_control", "to": "terminal_component_registry"},
    {"from": "terminal_input_control", "via": "submitted_input", "to": "pending_input_projection"},
    {"from": "pending_input_projection", "via": "typed_pending_cell", "to": "terminal_component_registry"},
    {"from": "official_session_log", "via": "matching_official_user_event", "to": "pending_input_projection"},
    {"from": "tui_focus_overlay_stack", "via": "active_view_selection", "to": "terminal_component_registry"},
    {"from": "tui_fixture_corpus", "via": "terminal_snapshot_input", "to": "terminal_component_registry"},
    {"from": "tui_fixture_corpus", "via": "browser_review_input", "to": "static_simulation"},
    {"from": "tui_presentation_model", "via": "typed_app_view_model", "to": "tui_app_container_composition"},
    {"from": "logic_control_registry", "via": "typed_chrome_projection_input", "to": "tui_chrome_slot_registry"},
    {"from": "tui_chrome_slot_registry", "via": "typed_chrome_state", "to": "tui_app_container_composition"},
    {"from": "tui_app_container_composition", "via": "typed_terminal_frame", "to": "terminal_lifecycle"},
    {"from": "tui_app_container_composition", "via": "typed_composition_error", "to": "app_composition_failure_chain"},
    {"from": "app_composition_failure_chain", "via": "typed_terminal_failure", "to": "terminal_failure_chain"}
  ],
  "forbidden_relations": [
    {"from": "terminal_component_registry", "to": "official_session_log", "reason": "renderer_must_not_consume_raw_events"},
    {"from": "current_session_selection", "to": "official_session_log", "reason": "no_direct_persistence_access"},
    {"from": "official_webui_reference", "to": "client_only_profile", "reason": "reference_source_not_runtime_dependency"},
    {"from": "transport_control", "to": "tui_presentation_model", "reason": "control_state_not_business_payload"},
    {"from": "terminal_component_registry", "to": "official_api_contract", "reason": "renderer_cannot_call_host"},
    {"from": "tui_focus_overlay_stack", "to": "official_session_log", "reason": "interaction_control_not_business_truth"},
    {"from": "terminal_input_control", "to": "official_session_log", "reason": "composer_scroll_and_overlay_control_are_not_business_truth"},
    {"from": "pending_input_projection", "to": "official_api_contract", "reason": "pending_projection_cannot_dispatch_or_reconstruct_business_mutations"},
    {"from": "terminal_failure_chain", "to": "official_api_contract", "reason": "terminal_error_control_cannot_reconstruct_business_requests"},
    {"from": "terminal_failure_chain", "to": "tui_presentation_model", "reason": "terminal_error_control_is_not_business_projection"},
    {"from": "static_simulation", "to": "official_dsh_host", "reason": "simulator_is_offline_only"},
    {"from": "tui_app_container_composition", "to": "official_session_log", "reason": "container_consumes_projection_only"},
    {"from": "tui_app_container_composition", "to": "official_api_contract", "reason": "container_cannot_call_host"},
    {"from": "tui_chrome_slot_registry", "to": "official_session_log", "reason": "chrome_slots_consume_projection_inputs_only"},
    {"from": "tui_chrome_slot_registry", "to": "official_api_contract", "reason": "chrome_slots_cannot_call_host"},
    {"from": "tui_chrome_slot_registry", "to": "terminal_lifecycle", "reason": "renderer_consumes_container_frame_not_slot_owner"}
  ]
}
