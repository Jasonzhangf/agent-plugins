{
  "schema_version": 1,
  "project_id": "dsh-tui",
  "sdk": {
    "name": "appsdk",
    "version": "0.1.3",
    "bundle_manifest": ".appsdk/contracts/sdk-bundle.manifest.json",
    "resource_record": ".appsdk/sdk-resources.json"
  },
  "lifecycle": {
    "stage": "draft"
  },
  "access": {
    "protected_paths": [
      ".appsdk/**",
      "active/lib/**",
      "generated/**",
      "protected/**"
    ]
  },
  "governance": {
    "playground_root": "playground/experiments/**",
    "active_root": "active/lib/**",
    "protected_root": "protected/**",
    "generated_root": "generated/**",
    "active_kind": "immutable_consumable_library",
    "protected_kinds": [
      "source",
      "contracts",
      "history"
    ],
    "generated_kinds": [
      "compiler_output",
      "indexes"
    ],
    "freeze_requirements": [
      "git_clean",
      "source_commit_or_tag",
      "library_hash",
      "public_api_hash",
      "review_pass",
      "previous_active_immutable"
    ],
    "promotion_requires": [
      "experiment_evidence",
      "architecture_review_pass",
      "unique_owner",
      "required_gates",
      "official_web_zero_diff",
      "clean_registry_install",
      "dual_client_live_session"
    ],
    "runtime_forbidden_roots": [
      ".appsdk-control/**",
      "playground/**",
      "generated/**",
      "protected/**"
    ],
    "record_contracts": [
      "contracts/records/worktree-record.schema.json",
      "contracts/records/reproduction-record.schema.json",
      "contracts/records/evidence-record.schema.json",
      "contracts/records/fix-candidate-record.schema.json",
      "contracts/records/goal-clarification-record.schema.json",
      "contracts/records/review-record.schema.json",
      "contracts/records/effectiveness-record.schema.json",
      "contracts/records/merge-record.schema.json",
      "contracts/records/promotion-record.schema.json",
      "contracts/records/regression-report.schema.json",
      "contracts/records/freeze-record.schema.json",
      "contracts/records/record-graph.contract.json"
    ],
    "zone_transition_contract": "contracts/transitions/zone-transition-manifest.json",
    "playground_retention": "archive_then_remove",
    "debug_merge_comment_required": true
  },
  "lifecycles": {
    "issue": "open",
    "library": "draft",
    "source_snapshot": "mutable",
    "artifact": "generated"
  },
  "modules": [
    {
      "module_id": "logic-controls",
      "stage": "draft",
      "owned_paths": [
        "playground/experiments/logic-controls/**",
        "tests/logic-controls/**",
        "contracts/tui/logic-controls/**",
        "scripts/build-logic-controls.mjs"
      ],
      "source_owner": "logic-controls",
      "active_artifact": "active/lib/logic-controls/**",
      "generated_outputs": [
        "generated/modules/logic-controls/**"
      ],
      "contract_paths": [
        "contracts/tui/logic-controls/**"
      ],
      "dependency_modules": [],
      "build": {
        "program": "pnpm",
        "args": [
          "run",
          "build:logic-controls"
        ],
        "working_directory": "."
      },
      "artifact_paths": [
        "logic-controls.js"
      ],
      "regression": {
        "required_before_freeze": true,
        "suite_id": "logic-controls-regression",
        "command": {
          "program": "pnpm",
          "args": [
            "run",
            "test:logic-controls"
          ],
          "working_directory": "."
        },
        "input_paths": [
          "playground/experiments/logic-controls/**",
          "tests/logic-controls/**"
        ],
        "minimum_test_count": 1,
        "allow_skipped": false,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
