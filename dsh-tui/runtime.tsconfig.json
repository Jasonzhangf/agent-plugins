{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./active/lib",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "playground/experiments/*/src/**/*.ts",
    "contracts/tui/**/*.ts"
  ],
  "exclude": [
    "tests/**",
    "scripts/**",
    "lib/**",
    "node_modules/**",
    "artifacts/**",
    "generated/**",
    "playground/experiments/*/tsconfig.json"
  ]
}
