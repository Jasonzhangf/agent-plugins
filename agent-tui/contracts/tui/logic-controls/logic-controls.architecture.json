{
  "schema_version": 1,
  "module_id": "logic-controls",
  "owner": "agent-tui::logic-controls",
  "status": "active",
  "owned_paths": [
    "src/experiments/logic-controls/**",
    "tests/logic-controls/**",
    "contracts/tui/logic-controls/**",
    "scripts/build-logic-controls.mjs"
  ],
  "forbidden_paths": [
    "src/experiments/component-registry/**",
    "contracts/tui/component-registry/**",
    "src/experiments/app-shell/**",
    "src/experiments/presentation/**",
    "src/experiments/transport/**",
    "src/experiments/session/**",
    "src/experiments/app-event-bus/**"
  ],
  "resources": [
    {"resource_id": "logic_control_registry", "kind": "control_registry", "truth_owner": "agent-tui::logic-controls", "allowed_operations": ["register", "bind_source", "project", "dispose"]},
    {"resource_id": "logic_control_error_projection", "kind": "error_projection", "truth_owner": "agent-tui::logic-controls", "allowed_operations": ["record", "read"]},
    {"resource_id": "terminal_input_control", "kind": "typed_control_side_channel", "truth_owner": "agent-tui::app-shell", "allowed_operations": ["emit"]},
    {"resource_id": "tui_status_control", "kind": "typed_control_side_channel", "truth_owner": "agent-tui::presentation", "allowed_operations": ["emit"]},
    {"resource_id": "tui_execution_control", "kind": "typed_control_side_channel", "truth_owner": "agent-tui::presentation", "allowed_operations": ["emit"]},
    {"resource_id": "transport_control", "kind": "typed_control_side_channel", "truth_owner": "agent-tui::transport", "allowed_operations": ["emit"]},
    {"resource_id": "current_session_selection", "kind": "typed_control_side_channel", "truth_owner": "agent-tui::session", "allowed_operations": ["emit"]},
    {"resource_id": "tui_app_event_bus", "kind": "typed_control_side_channel", "truth_owner": "agent-tui::app-event-bus", "allowed_operations": ["emit"]}
  ],
  "functions": [
    {"function_id": "install_logic_control_plugins", "owner": "agent-tui::logic-controls", "entry_symbols": ["apply", "applyInput", "applyStatus", "applyConnection", "applyExecution", "applySession", "applySlashCommand", "applyLogo"], "required_tests": ["logic-controls-plugin-registration", "logic-controls-disposal"]},
    {"function_id": "bind_logic_control_source", "owner": "agent-tui::logic-controls", "entry_symbols": ["TuiLogicControlRegistry.bindSource", "LogicControlSourceCapability.dispatch"], "required_tests": ["logic-controls-source-ownership", "logic-controls-source-disposal"]},
    {"function_id": "dispatch_logic_control_event", "owner": "agent-tui::logic-controls", "entry_symbols": ["TuiLogicControlRegistryService.dispatchFromSource"], "required_tests": ["logic-controls-positive-projection", "logic-controls-negative-error-chain", "logic-controls-payload-separation"]}
  ],
  "edges": [
    {"edge_id": "logic-control-input-to-registry", "from": "terminal_input_control", "to": "logic_control_registry", "conversion": "typed_input_control_to_input_projection"},
    {"edge_id": "logic-control-status-to-registry", "from": "tui_status_control", "to": "logic_control_registry", "conversion": "typed_status_control_to_status_projection"},
    {"edge_id": "logic-control-execution-to-registry", "from": "tui_execution_control", "to": "logic_control_registry", "conversion": "typed_execution_control_to_execution_projection"},
    {"edge_id": "logic-control-connection-to-registry", "from": "transport_control", "to": "logic_control_registry", "conversion": "typed_connection_control_to_connection_projection"},
    {"edge_id": "logic-control-session-to-registry", "from": "current_session_selection", "to": "logic_control_registry", "conversion": "typed_session_control_to_session_projection"},
    {"edge_id": "logic-control-command-to-registry", "from": "tui_app_event_bus", "to": "logic_control_registry", "conversion": "typed_public_command_to_command_projection"},
    {"edge_id": "logic-control-logo-to-registry", "from": "logic_control_registry", "to": "logic_control_registry", "conversion": "typed_branding_intent_to_logo_projection"},
    {"edge_id": "logic-control-error-to-projection", "from": "logic_control_registry", "to": "logic_control_error_projection", "conversion": "typed_control_error_to_error_projection"}
  ],
  "gates": [
    {"gate_id": "logic-controls-plugin-registration", "command": "pnpm run test:logic-controls", "required": true},
    {"gate_id": "logic-controls-build", "command": "pnpm run build:logic-controls", "required": true},
    {"gate_id": "logic-controls-typecheck", "command": "pnpm run typecheck", "required": true},
    {"gate_id": "logic-controls-boundary", "command": "pnpm run check:runtime-boundaries", "required": true},
    {"gate_id": "logic-controls-payload-separation", "command": "pnpm run test:logic-controls", "required": true},
    {"gate_id": "logic_control_manifest", "command": "jq empty contracts/tui/logic-controls/logic-controls.manifest.json contracts/tui/logic-controls/logic-controls.architecture.json", "required": true}
  ]
}
