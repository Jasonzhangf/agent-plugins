{
  "contract": "tui.app-container.v2",
  "status": "active",
  "owner": "agent-tui::app-container",
  "layouts": ["default", "compact"],
  "slots": [
    "header.logo",
    "header.connection",
    "header.session",
    "header.status",
    "transcript",
    "execution",
    "composer",
    "overlay",
    "footer"
  ],
  "input": "TuiAppViewModel",
  "output": "TuiAppContainerFrame",
  "allowed_edges": [
    "TuiAppViewModel -> tui.app.container",
    "tui.app.container -> tui.terminal-ui",
    "tui.terminal-ui -> tui.terminal-lifecycle"
  ],
  "forbidden_dependencies": [
    "session truth",
    "transport",
    "agent adapter",
    "logic-control reducer",
    "second renderer"
  ],
  "verification_gates": [
    "test:app-container",
    "test:terminal-ui",
    "test:terminal-lifecycle",
    "test:app-shell",
    "typecheck",
    "build:app-container",
    "build:runtime",
    "runtime-boundary"
  ]
}
