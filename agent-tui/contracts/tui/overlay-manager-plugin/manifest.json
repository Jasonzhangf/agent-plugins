{
  "contract": "tui.overlay-manager-plugin.v1",
  "status": "active",
  "owner": "agent-tui::overlay-manager-plugin",
  "service": "tuiOverlayManager",
  "resource": "tui_overlay_manager_control",
  "view_priority": [
    "approval-question",
    "selector.resume-current-cwd",
    "command",
    "queue",
    "overlay.jobs",
    "overlay.trajectory",
    "overlay.help",
    "composer"
  ],
  "publication": "one_immutable_top_view_state_per_transition",
  "consumers": [
    {"module": "agent-tui::app-shell", "face": "top_view_key_routing"},
    {"module": "agent-tui::refresh-orchestrator", "face": "request_overlay_change"}
  ],
  "forbidden_consumer_payload_fields": [
    "onSelect",
    "onClose",
    "transportRevision",
    "hostRevision",
    "composerText"
  ]
}
