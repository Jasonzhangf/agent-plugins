{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-plugins.local/agent-tui/fixture-case.schema.json",
  "title": "TUI fixture case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "componentKind",
    "viewport",
    "node"
  ],
  "properties": {
    "fixtureId": {"type": "string", "minLength": 1},
    "componentKind": {"type": "string", "minLength": 1},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "node": {
      "$ref": "canonical-node.schema.json"
    }
  }
}
