{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-plugins.local/agent-tui/markdown-semantic-tokens.schema.json",
  "title": "Normalized semantic-token expectations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {
      "enum": ["pending_normalization", "admitted"]
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["settled", "streaming"],
          "properties": {
            "settled": {"type": "array", "items": {"type": "string"}},
            "streaming": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
