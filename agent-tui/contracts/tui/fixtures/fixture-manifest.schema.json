{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-plugins.local/agent-tui/fixture-manifest.schema.json",
  "title": "TUI fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundleId", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "bundleId": {"type": "string", "minLength": 1},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture_entry"
      }
    }
  },
  "$defs": {
    "fixture_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "componentKind", "viewport", "file"],
      "properties": {
        "fixtureId": {"type": "string", "minLength": 1},
        "componentKind": {"type": "string", "minLength": 1},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "rows"],
          "properties": {
            "columns": {"type": "integer", "minimum": 1},
            "rows": {"type": "integer", "minimum": 1}
          }
        },
        "file": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": false
}
