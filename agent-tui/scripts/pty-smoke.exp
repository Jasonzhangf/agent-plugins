#!/usr/bin/expect -f
# PTY smoke: run the built agent-tui CLI under a real PTY, send /quit, verify exit.
set timeout 40
set workroot [file normalize [file join [file dirname [info script]] ..]]
set outfile [lindex $argv 0]
if {$outfile ne ""} {
  log_file -a $outfile
}
set stty_init "rows 24 columns 80"
spawn -noecho /opt/homebrew/bin/agent-tui --endpoint http://127.0.0.1:4096 --cwd $workroot
sleep 6
set send_slow {1 0.1}
send -s -- "/quit"
expect {
  -re {> } {}
  timeout {
    puts "PTY_INPUT_TIMEOUT"
    exit 1
  }
}
send -- "\r"
expect {
  eof {
    puts "PTY_EXIT_REACHED"
  }
  timeout {
    puts "PTY_TIMEOUT"
    exit 1
  }
}
set wait_status [wait]
puts "PTY_WAIT_RESULT=$wait_status"
set child_exit [lindex $wait_status 3]
if {$child_exit != 0} {
  exit $child_exit
}
exit 0
