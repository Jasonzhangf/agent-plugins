#!/bin/sh
set -eu

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "agent-tui: pushes to $remote_ref are forbidden; merge through the governed mainline" >&2
      exit 1
      ;;
  esac
done

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root/agent-tui"
pnpm run check # verify:ci
