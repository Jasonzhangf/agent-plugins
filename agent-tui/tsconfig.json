{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "#tui-component-registry-manifest": ["./contracts/tui/component-registry/manifest.json"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/experiments/*/src/**/*.ts",
    "contracts/tui/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "lib/**",
    "node_modules/**",
    "artifacts/**",
    "generated/**"
  ]
}
