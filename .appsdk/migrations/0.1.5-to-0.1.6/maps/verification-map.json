    {"gate_id":"child_governance_binding","command":"appsdk guide status <child-project>","required_for":["module_classification"]},
    {"gate_id":"guidance_requirements","command":"appsdk guide init <project> --task <task-id> --mode develop --module <module-id>","human_contract":"Record objective, scope, non-goals, acceptance, and the one-line task decision before map inspection.","required_for":["feature_requirements"]},
    {"gate_id":"guidance_map_check","command":"appsdk verify <project>","human_contract":"Read the actual project resource/function/mainline/module/verification maps and bind the feature owner before source edits.","required_for":["feature_map_check"]},
    {"gate_id":"guidance_architecture_optional","command":"appsdk guide plan <project> --task <task-id> --input <plan.json>","human_contract":"Use only when existing design and maps do not cover the change; otherwise record an explicit bypass.","required_for":["feature_architecture_optional"]},
    {"gate_id":"guidance_implementation","command":"git diff --check","required_for":["feature_implementation"]},
    {"gate_id":"guidance_candidate","command":"git status --short --branch","required_for":["feature_candidate"]},
    {"gate_id":"guidance_validation","command":"appsdk verify <project>","required_for":["feature_validation"]},
    {"gate_id":"guidance_map_update_optional","command":"appsdk verify <project>","human_contract":"Run when feature, owner, path, or gate bindings changed; otherwise record an explicit bypass.","required_for":["feature_map_update_optional"]},
    {"gate_id":"guidance_review","command":"appsdk verify --review-admission <project> --module <module-id>","human_contract":"Review the unchanged validated candidate and map boundaries before merge or push.","required_for":["feature_review"]},
    {"gate_id":"guidance_effectiveness_optional","command":"appsdk verify <project>","human_contract":"Replay the unchanged candidate for runtime or higher-risk changes; record a bypass for low-risk non-runtime work.","required_for":["feature_effectiveness_optional"]},
    {"gate_id":"guidance_integration","command":"git diff --check && git rev-parse HEAD","required_for":["feature_integration"]},
    {"gate_id":"guidance_promotion_optional","command":"appsdk verify <project>","human_contract":"Use only when immutable Active/Protected delivery is required; otherwise proceed to cleanup.","required_for":["feature_promotion_optional"]},
    {"gate_id":"guidance_cleanup","command":"git diff --check && git worktree list --porcelain","required_for":["feature_cleanup"]},
    {"gate_id":"guidance_debug_orient","command":"appsdk guide init <project> --task <task-id> --mode debug --module <module-id>","human_contract":"Read AGENTS, notes, records, resource/function/mainline/module maps, and verification gates, then bind the issue and unique owner.","required_for":["debug_orient_context"]},
    {"gate_id":"guidance_debug_resolve","command":"appsdk verify <project>","human_contract":"Fix the mapped owner, add necessary regression coverage, and update maps/gates when the verified contract changes.","required_for":["debug_resolve_owner"]}
  ]
