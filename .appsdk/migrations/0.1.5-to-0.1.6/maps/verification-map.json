    {"gate_id":"guidance_function_map_binding","command":"appsdk verify <project>","required_for":["debug_start","resolve"]},
    {"gate_id":"guidance_exploration_notes","command":"appsdk guide update <project> --task <task-id> --input <result.json>","required_for":["debug_explore","debug_resolve"]},
